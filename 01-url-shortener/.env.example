# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:4000

# Authentication
JWT_SECRET=super-secret-jwt-key-tradeo-phase1-change-in-production
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://tradeo_user:tradeo_password@localhost:5432/url_shortener_db?schema=public

# Redis Configuration (Cache for hot redirects)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
MAX_LINKS_PER_ANONYMOUS_IP=20
