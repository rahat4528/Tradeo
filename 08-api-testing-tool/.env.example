# Port Configuration
PORT=4007
FRONTEND_PORT=3007
DATABASE_PORT=5439

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/api_testing_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-api-testing-tool-key-32chars"
JWT_EXPIRES_IN="7d"

# Dispatch Proxy & Security
DISPATCH_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=10485760
ALLOW_LOCAL_DISPATCH=true

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4007/api/v1"
