# Application Environment
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:3001
APP_BASE_URL=http://localhost:4001

# Authentication
JWT_SECRET=super-secret-jwt-key-tradeo-phase2-snippets-manager
