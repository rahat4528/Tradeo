datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services  Service[]

  @@map("users")
}

model Service {
  id              String        @id @default(uuid())
  userId          String
  name            String
  url             String
  environment     Environment   @default(PRODUCTION)
  status          ServiceStatus @default(HEALTHY)
  uptimePercent   Float         @default(99.99)
  intervalSeconds Int           @default(30)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics         MetricSnapshot[]
  alerts          AlertRule[]
  incidents       Incident[]
  deployments     Deployment[]
  logs            LogEntry[]

  @@index([userId])
  @@map("services")
}

model MetricSnapshot {
  id            String   @id @default(uuid())
  serviceId     String
  cpuPercent    Float
  memoryPercent Float
  requestRate   Float
  latencyMs     Float
  errorRate     Float
  timestamp     DateTime @default(now())

  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, timestamp])
  @@map("metric_snapshots")
}

model AlertRule {
  id         String   @id @default(uuid())
  serviceId  String
  metricType String   // CPU, MEMORY, LATENCY, ERROR_RATE, STATUS
  operator   String   // GT, LT, EQ
  threshold  Float
  severity   Severity @default(WARNING)
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  incidents  Incident[]

  @@index([serviceId])
  @@map("alert_rules")
}

model Incident {
  id              String         @id @default(uuid())
  serviceId       String
  alertRuleId     String?
  title           String
  description     String?
  severity        Severity       @default(WARNING)
  status          IncidentStatus @default(TRIGGERED)
  triggeredAt     DateTime       @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  acknowledgedBy  String?
  resolvedBy      String?

  service         Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  alertRule       AlertRule?     @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)

  @@index([serviceId, status])
  @@map("incidents")
}

model Deployment {
  id              String      @id @default(uuid())
  serviceId       String
  version         String
  commitSha       String
  branch          String      @default("main")
  environment     Environment @default(PRODUCTION)
  deployer        String      @default("GitHub Actions")
  status          String      @default("SUCCESS")
  durationSeconds Int?
  createdAt       DateTime    @default(now())

  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("deployments")
}

model LogEntry {
  id        String   @id @default(uuid())
  serviceId String
  level     LogLevel @default(INFO)
  message   String
  timestamp DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, timestamp])
  @@map("log_entries")
}
