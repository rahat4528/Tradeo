datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String?
  timezone     String      @default("UTC")
  categories   Category[]
  tasks        Task[]
  reminders    Reminder[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6366F1") // Indigo default
  icon      String   @default("folder")
  sortOrder Int      @default(0)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("categories")
}

model Task {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  priority           Priority       @default(MEDIUM)
  status             TaskStatus     @default(TODO)
  dueDate            DateTime?
  recurrence         RecurrenceRule @default(NONE)
  recurrenceInterval Int            @default(1)
  estimatedMinutes   Int?
  tags               String?        // Comma-separated tags, e.g. "dev,backend,v1"
  completedAt        DateTime?
  subtasks           Subtask[]
  reminders          Reminder[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([categoryId])
  @@map("tasks")
}

model Subtask {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@map("subtasks")
}

model Reminder {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  isSent    Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isSent])
  @@index([remindAt, isSent])
  @@map("reminders")
}
