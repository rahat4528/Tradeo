# Inventory Management Environment Configuration
NODE_ENV=development
PORT=4004

# PostgreSQL Database (dedicated port 5436)
DATABASE_URL="postgresql://tradeo_user:tradeo_secure_pass@localhost:5436/inventory_management_db?schema=public"

# Redis Queue & Cache (dedicated port 6381)
REDIS_HOST=localhost
REDIS_PORT=6381

# JWT Authentication
JWT_SECRET=super-secret-inventory-management-jwt-key
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:4004/api/v1
