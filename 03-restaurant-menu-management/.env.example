# Application Environment
NODE_ENV=development
PORT=4002
FRONTEND_URL=http://localhost:3002
APP_BASE_URL=http://localhost:4002

# Authentication
JWT_SECRET=super-secret-jwt-key-tradeo-phase3-restaurant-menu
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://tradeo_user:tradeo_password@localhost:5432/restaurant_menu_db?schema=public

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tradeo-menu-images
S3_REGION=us-east-1

# Throttling
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=150
